# --- AUTH ENDPOINTS ---

@app.post("/auth/send-otp")
async def send_otp(request: schemas.OTPSend, db: Session = Depends(get_db)):
    identifier = request.identifier.lower()
    otp_code = "".join([str(random.randint(0, 9)) for _ in range(6)])
    expiry = datetime.now(timezone.utc) + timedelta(minutes=10)
    
    db_otp = models.EmailOTP(
        identifier=identifier,
        otp_code=otp_code,
        expires_at=expiry
    )
    db.add(db_otp)
    db.commit()
    
    # Logic to distinguish between email and phone
    if "@" not in identifier:
        raise HTTPException(status_code=400, detail="Only email verification is supported.")

    # Send Email OTP
    print(f"DEBUG: Sending Email OTP {otp_code} to {identifier}")
    try:
        message = MessageSchema(
            subject="Your LeadintelAI Verification Code",
            recipients=[identifier],
            body=f"Your OTP code is: {otp_code}. Valid for 10 minutes.",
            subtype="html"
        )
        fm = FastMail(conf)
        await fm.send_message(message)
    except Exception as e:
        print(f"Error sending email: {e}")
        raise HTTPException(status_code=500, detail=f"Failed to send OTP email: {str(e)}")
    
    return {"message": f"OTP sent successfully to {identifier}"}

@app.post("/auth/verify-otp")
async def verify_otp(request: schemas.OTPVerify, db: Session = Depends(get_db)):
    identifier = (request.identifier or request.email or "").lower()
    if not identifier:
        raise HTTPException(status_code=400, detail="Identifier (email or phone) is required.")

    print(f"DEBUG: Verifying OTP for {identifier}")
    
    db_otp = db.query(models.EmailOTP).filter(
        models.EmailOTP.identifier == identifier
    ).order_by(models.EmailOTP.created_at.desc()).first()
    
    if not db_otp:
        raise HTTPException(status_code=400, detail="No OTP code requested for this identifier. Please request a new code.")
    
    if db_otp.is_locked:
        raise HTTPException(status_code=429, detail="This verification session is locked due to too many failed attempts. Please request a new OTP.")

    # Ensure timing matches
    now = datetime.now(timezone.utc)
    otp_expiry = db_otp.expires_at
    if otp_expiry.tzinfo is None:
        otp_expiry = otp_expiry.replace(tzinfo=timezone.utc)
        
    if otp_expiry < now:
        raise HTTPException(status_code=400, detail="OTP code has expired. Please request a new code.")

    # Validate code with attempt tracking
    if db_otp.otp_code != request.otp_code:
        db_otp.attempts_count = (db_otp.attempts_count or 0) + 1
        if db_otp.attempts_count >= 5:
            db_otp.is_locked = True
            db.commit()
            raise HTTPException(status_code=429, detail="Maximum verification attempts exceeded (5). Code is now locked.")
        db.commit()
        remaining = 5 - db_otp.attempts_count
        raise HTTPException(status_code=400, detail=f"Invalid OTP code. {remaining} attempt(s) remaining.")

    # Success: Mark as verified so /register or password resets can trust it
    db_otp.is_verified = True
    db.commit()
    
    return {"message": "OTP verified successfully"}

@app.post("/auth/google")
async def google_auth(request: schemas.GoogleToken, db: Session = Depends(get_db)):
    try:
        # Verify the ID token using the Google verify_oauth2_info
        # Note: In a real app, you MUST use the GOOGLE_CLIENT_ID from your env
        CLIENT_ID = os.getenv("GOOGLE_CLIENT_ID")
        
        idinfo = id_token.verify_oauth2_token(
            request.id_token, 
            google_requests.Request(), 
            CLIENT_ID
        )

        # ID token is valid. Extract user info
        email = idinfo['email']
        first_name = idinfo.get('given_name', 'Google')
        last_name = idinfo.get('family_name', 'User')
        
        # Check if user exists
        user = db.query(models.User).filter(models.User.email == email).first()
        
        if not user:
            # Create a new user if they don't exist
            # Generate a random password since it's required by the model
            random_pw = ''.join(random.choices(string.ascii_letters + string.digits, k=16))
            hashed_pw = auth.get_password_hash(random_pw)
            
            user = models.User(
                email=email,
                hashed_password=hashed_pw,
                first_name=first_name,
                last_name=last_name,
                company_name="Google User",
                phone_number=None,
                is_active=True,
                wallet_balance=0.0
            )
            db.add(user)
            db.commit()
            db.refresh(user)

        # Create access token
        access_token_expires = timedelta(minutes=auth.ACCESS_TOKEN_EXPIRE_MINUTES)
        access_token = auth.create_access_token(
            data={"sub": user.email}, expires_delta=access_token_expires
        )
        
        return {
            "access_token": access_token, 
            "token_type": "bearer",
            "email": user.email,
            "user": {
                "first_name": user.first_name,
                "last_name": user.last_name,
                "email": user.email,
                "company_name": user.company_name,
                "needs_completion": user.company_name == "Google User"
            }
        }
    except ValueError as e:
        # Invalid token
        raise HTTPException(status_code=401, detail=f"Invalid Google Token: {str(e)}")
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@app.post("/token", response_model=schemas.Token)
async def login_for_access_token(form_data: OAuth2PasswordRequestForm = Depends(), db: Session = Depends(get_db)):
    user = db.query(models.User).filter(models.User.email == form_data.username.lower()).first()
    if not user or not auth.verify_password(form_data.password, user.hashed_password):
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Incorrect email or password",
            headers={"WWW-Authenticate": "Bearer"},
        )
    
    access_token = auth.create_access_token(data={"sub": user.email})
    return {"access_token": access_token, "token_type": "bearer"}

@app.post("/auth/login-otp", response_model=schemas.Token)
async def login_with_otp(request: schemas.OTPVerify, db: Session = Depends(get_db)):
    identifier = (request.identifier or request.email or "").lower()
    if not identifier:
        raise HTTPException(status_code=400, detail="Email is required.")
        
    user = db.query(models.User).filter(models.User.email == identifier).first()
    if not user:
        raise HTTPException(status_code=404, detail="User not found with this email.")
        
    db_otp = db.query(models.EmailOTP).filter(
        models.EmailOTP.identifier == identifier
    ).order_by(models.EmailOTP.created_at.desc()).first()
    
    if not db_otp:
        raise HTTPException(status_code=400, detail="No OTP code requested for this email.")
        
    if db_otp.is_locked:
        raise HTTPException(status_code=429, detail="This OTP login is locked due to too many failed attempts. Please request a new code.")
        
    now = datetime.now(timezone.utc)
    otp_expiry = db_otp.expires_at
    if otp_expiry.tzinfo is None:
        otp_expiry = otp_expiry.replace(tzinfo=timezone.utc)
        
    if otp_expiry < now:
        raise HTTPException(status_code=400, detail="OTP code has expired. Please request a new code.")
        
    if db_otp.otp_code != request.otp_code:
        db_otp.attempts_count = (db_otp.attempts_count or 0) + 1
        if db_otp.attempts_count >= 5:
            db_otp.is_locked = True
            db.commit()
            raise HTTPException(status_code=429, detail="Maximum login attempts exceeded. Code is now locked.")
        db.commit()
        remaining = 5 - db_otp.attempts_count
        raise HTTPException(status_code=400, detail=f"Invalid OTP code. {remaining} attempt(s) remaining.")

    # Mark as used/delete
    db.delete(db_otp)
    db.commit()
    
    access_token = auth.create_access_token(data={"sub": user.email})
    return {"access_token": access_token, "token_type": "bearer"}

@app.post("/auth/reset-password")
async def reset_password(request: schemas.PasswordReset, db: Session = Depends(get_db)):
    email_lower = request.email.lower()
    user = db.query(models.User).filter(models.User.email == email_lower).first()
    if not user:
        raise HTTPException(status_code=404, detail="User not found.")
        
    recent_otp = db.query(models.EmailOTP).filter(
        models.EmailOTP.identifier == email_lower,
        models.EmailOTP.is_verified == True
    ).order_by(models.EmailOTP.created_at.desc()).first()
    
    if not recent_otp:
        raise HTTPException(status_code=400, detail="Email not verified. Please verify an OTP first.")
        
    # Delete the verification record after use
    db.delete(recent_otp)
    
    hashed_password = auth.get_password_hash(request.new_password)
    user.hashed_password = hashed_password
    db.commit()
    
    return {"message": "Password updated successfully"}

@app.post("/register", response_model=schemas.User)
async def register_user(user: schemas.UserCreate, db: Session = Depends(get_db)):
    # 1. Check if email is verified
    email_otp = db.query(models.EmailOTP).filter(
        models.EmailOTP.identifier == user.email.lower(),
        models.EmailOTP.is_verified == True
    ).order_by(models.EmailOTP.created_at.desc()).first()

    if not email_otp:
        raise HTTPException(status_code=400, detail="Email must be verified with OTP first.")
    
    # 2. Cleanup verification records
    db.delete(email_otp)
    
    db_user = db.query(models.User).filter(models.User.email == user.email.lower()).first()
    if db_user:
        raise HTTPException(status_code=400, detail="Email already registered")
    
    hashed_password = auth.get_password_hash(user.password)
    new_user = models.User(
        email=user.email.lower(),
        first_name=user.first_name,
        last_name=user.last_name,
        company_name=user.company_name,
        phone_number=user.phone_number,
        hashed_password=hashed_password,
        wallet_balance=100.0
    )
    db.add(new_user)
    db.commit()
    db.refresh(new_user)
    return new_user

@app.get("/users/me", response_model=schemas.User)
async def read_users_me(current_user: models.User = Depends(auth.get_current_user)):
    return current_user

@app.patch("/users/me", response_model=schemas.User)
async def update_user_me(
    user_update: schemas.UserUpdate, 
    db: Session = Depends(get_db),
    current_user: models.User = Depends(auth.get_current_user)
):
    if user_update.first_name:
        current_user.first_name = user_update.first_name
    if user_update.last_name:
        current_user.last_name = user_update.last_name
    if user_update.company_name:
        current_user.company_name = user_update.company_name
    if user_update.password:
        current_user.hashed_password = auth.get_password_hash(user_update.password)
    
    db.commit()
    db.refresh(current_user)
    return current_user

# --- LEAD ENDPOINTS ---

@app.get("/leads/search", response_model=schemas.PaginatedLeadsResponse)
async def search_leads(
    industry: Optional[str] = None,
    location: Optional[str] = None,
    job_title: Optional[str] = None,
    page: int = Query(1, ge=1, description="Page number (1-indexed)"),
    page_size: int = Query(20, ge=1, le=100, description="Items per page (default: 20)"),
    cursor: Optional[int] = Query(None, description="Cursor: Lead ID for O(1) keyset pagination"),
    db: Session = Depends(get_db),
    current_user: models.User = Depends(auth.get_current_user)
):
    query = db.query(models.Lead)
    if industry:
        query = query.filter(models.Lead.industry.contains(industry))
    if location:
        query = query.filter(models.Lead.location.contains(location))
    if job_title:
        query = query.filter(models.Lead.job_title.contains(job_title))
    
    total = query.count()

    if cursor is not None:
        # High-performance keyset/cursor pagination for massive lead catalog
        query = query.filter(models.Lead.id > cursor).order_by(models.Lead.id.asc())
        leads = query.limit(page_size + 1).all()
        has_more = len(leads) > page_size
        items = leads[:page_size]
        next_cursor = items[-1].id if has_more and items else None
        current_page = None
        next_page = None
    else:
        # Standard offset-based pagination
        offset = (page - 1) * page_size
        leads = query.order_by(models.Lead.id.asc()).offset(offset).limit(page_size + 1).all()
        has_more = len(leads) > page_size
        items = leads[:page_size]
        next_cursor = items[-1].id if has_more and items else None
        current_page = page
        next_page = page + 1 if has_more else None

    if items:
        # BATCH FETCH (Eliminates N+1 query problem):
        lead_ids = [l.id for l in items]
        unlocked_ids = {
            r[0] for r in db.query(models.UnlockedLead.lead_id).filter(
                models.UnlockedLead.user_id == current_user.id,
                models.UnlockedLead.lead_id.in_(lead_ids)
            ).all()
        }
        for lead in items:
            lead.is_unlocked = lead.id in unlocked_ids
            
    return {
        "items": items,
        "page": current_page,
        "page_size": page_size,
        "total": total,
        "has_more": has_more,
        "next_page": next_page,
        "next_cursor": next_cursor
    }

@app.get("/leads/unlocked", response_model=schemas.PaginatedUnlockedLeadsResponse)
async def get_unlocked_leads(
    page: int = Query(1, ge=1, description="Page number (1-indexed)"),
    page_size: int = Query(20, ge=1, le=100, description="Items per page (default: 20)"),
    cursor: Optional[int] = Query(None, description="Cursor: UnlockedLead ID for pagination"),
    current_user: models.User = Depends(auth.get_current_user),
    db: Session = Depends(get_db)
):
    """
    Retrieve unlocked leads for the authenticated user with cursor & offset pagination.
    Defaults to 20 items per page with SQL JOIN.
    """
    base_query = db.query(models.Lead).join(
        models.UnlockedLead, models.Lead.id == models.UnlockedLead.lead_id
    ).filter(
        models.UnlockedLead.user_id == current_user.id
    )
    total = base_query.count()

    if cursor is not None:
        query = base_query.filter(models.UnlockedLead.id < cursor).order_by(models.UnlockedLead.id.desc())
        results = query.limit(page_size + 1).all()
        has_more = len(results) > page_size
        items = results[:page_size]
        next_cursor = None
        if has_more and items:
            last_ul = db.query(models.UnlockedLead.id).filter(
                models.UnlockedLead.user_id == current_user.id,
                models.UnlockedLead.lead_id == items[-1].id
            ).first()
            next_cursor = last_ul[0] if last_ul else None
        current_page = None
        next_page = None
    else:
        offset = (page - 1) * page_size
        query = base_query.order_by(models.UnlockedLead.unlocked_at.desc(), models.UnlockedLead.id.desc())
        results = query.offset(offset).limit(page_size + 1).all()
        has_more = len(results) > page_size
        items = results[:page_size]
        next_cursor = None
        current_page = page
        next_page = page + 1 if has_more else None

    return {
        "items": items,
        "page": current_page,
        "page_size": page_size,
        "total": total,
        "has_more": has_more,
        "next_page": next_page,
        "next_cursor": next_cursor
    }

@app.post("/leads/batch-unlock", response_model=schemas.BatchUnlockResponse)
async def batch_unlock_leads(
    request: schemas.BatchUnlockRequest,
    db: Session = Depends(get_db),
    current_user: models.User = Depends(auth.get_current_user)
):
    """
    Batch unlock multiple leads in a single database transaction.
    Uses SQLAlchemy's .in_() filter to batch query leads and existing unlock records,
    eliminating N+1 queries inside a loop.
    """
    if not request.lead_ids:
        return {
            "unlocked_count": 0,
            "total_cost": 0.0,
            "remaining_balance": current_user.wallet_balance,
            "leads": []
        }

    unique_lead_ids = list(set(request.lead_ids))

    # Single batched query for existing unlocks using .in_()
    already_unlocked_ids = {
        r[0] for r in db.query(models.UnlockedLead.lead_id).filter(
            models.UnlockedLead.user_id == current_user.id,
            models.UnlockedLead.lead_id.in_(unique_lead_ids)
        ).all()
    }

    # Single batched query for target leads using .in_()
    target_leads = db.query(models.Lead).filter(models.Lead.id.in_(unique_lead_ids)).all()
    leads_to_unlock = [l for l in target_leads if l.id not in already_unlocked_ids]

    total_cost = sum(l.price_to_unlock for l in leads_to_unlock)
    if current_user.wallet_balance < total_cost:
        raise HTTPException(
            status_code=400,
            detail=f"Insufficient wallet balance. Required: ₹{total_cost}, Available: ₹{current_user.wallet_balance}"
        )

    if leads_to_unlock:
        current_user.wallet_balance -= total_cost
        
        # Batch insert transactions and unlocked_leads records
        for lead in leads_to_unlock:
            db.add(models.Transaction(
                user_id=current_user.id,
                amount=-lead.price_to_unlock,
                type=models.TransactionType.DEBIT,
                description=f"Batch unlocked lead: {lead.name} at {lead.company}"
            ))
            db.add(models.UnlockedLead(user_id=current_user.id, lead_id=lead.id))

        db.commit()

    return {
        "unlocked_count": len(leads_to_unlock),
        "total_cost": total_cost,
        "remaining_balance": current_user.wallet_balance,
        "leads": target_leads
    }

@app.post("/leads/{lead_id}/unlock", response_model=schemas.LeadDetail)
async def unlock_lead(
    lead_id: int, 
    db: Session = Depends(get_db),
    current_user: models.User = Depends(auth.get_current_user)
):
    # Check if already unlocked
    existing = db.query(models.UnlockedLead).filter(
        models.UnlockedLead.user_id == current_user.id,
        models.UnlockedLead.lead_id == lead_id
    ).first()
    
    lead = db.query(models.Lead).filter(models.Lead.id == lead_id).first()
    if not lead:
        raise HTTPException(status_code=404, detail="Lead not found")

    if existing:
        return lead

    # Check balance
    if current_user.wallet_balance < lead.price_to_unlock:
        raise HTTPException(status_code=400, detail="Insufficient wallet balance")

    # Deduct funds
    current_user.wallet_balance -= lead.price_to_unlock
    
    # Create transaction record
    transaction = models.Transaction(
        user_id=current_user.id,
        amount=-lead.price_to_unlock,
        type=models.TransactionType.DEBIT,
        description=f"Unlocked lead: {lead.name} at {lead.company}"
    )
    
    # Record unlock
    unlocked = models.UnlockedLead(user_id=current_user.id, lead_id=lead_id)
    
    db.add(transaction)
    db.add(unlocked)
    db.commit()
    
    return lead

# --- WALLET & CAMPAIGN ENDPOINTS ---

@app.get("/wallet/history", response_model=schemas.PaginatedTransactionsResponse)
async def get_wallet_history(
    page: int = Query(1, ge=1, description="Page number (1-indexed)"),
    page_size: int = Query(20, ge=1, le=100, description="Items per page (default: 20)"),
    cursor: Optional[int] = Query(None, description="Cursor: transaction ID to load older records"),
    current_user: models.User = Depends(auth.get_current_user),
    db: Session = Depends(get_db)
):
    base_query = db.query(models.Transaction).filter(models.Transaction.user_id == current_user.id)
    total = base_query.count()

    if cursor is not None:
        # High-performance cursor pagination for growing ledger
        query = base_query.filter(models.Transaction.id < cursor).order_by(models.Transaction.id.desc())
        txs = query.limit(page_size + 1).all()
        has_more = len(txs) > page_size
        items = txs[:page_size]
        next_cursor = items[-1].id if has_more and items else None
        current_page = None
        next_page = None
    else:
        # Offset pagination
        offset = (page - 1) * page_size
        query = base_query.order_by(models.Transaction.timestamp.desc(), models.Transaction.id.desc())
        txs = query.offset(offset).limit(page_size + 1).all()
        has_more = len(txs) > page_size
        items = txs[:page_size]
        next_cursor = items[-1].id if has_more and items else None
        current_page = page
        next_page = page + 1 if has_more else None

    return {
        "items": items,
        "page": current_page,
        "page_size": page_size,
        "total": total,
        "has_more": has_more,
        "next_page": next_page,
        "next_cursor": next_cursor
    }

@app.get("/campaigns", response_model=schemas.PaginatedCampaignsResponse)
async def get_campaigns(
    page: int = Query(1, ge=1, description="Page number (1-indexed)"),
    page_size: int = Query(20, ge=1, le=100, description="Items per page (default: 20)"),
    current_user: models.User = Depends(auth.get_current_user),
    db: Session = Depends(get_db)
):
    base_query = db.query(models.WhatsAppCampaign).filter(models.WhatsAppCampaign.user_id == current_user.id)
    total = base_query.count()
    offset = (page - 1) * page_size
    campaigns = base_query.order_by(models.WhatsAppCampaign.created_at.desc(), models.WhatsAppCampaign.id.desc()).offset(offset).limit(page_size).all()
    has_more = (offset + len(campaigns)) < total
    return {
        "items": campaigns,
        "page": page,
        "page_size": page_size,
        "total": total,
        "has_more": has_more,
        "next_page": page + 1 if has_more else None
    }

# --- AI ENDPOINTS ---

@app.post("/ai/chat", response_model=schemas.ChatResponse)
async def ai_chat(
    request: schemas.ChatRequest,
    db: Session = Depends(get_db)
):
    # Public chatbot doesn't require current_user
    # We use a default high-quality personality for the landing page
    system_prompt = "You are a friendly, expert sales assistant for LeadintelAI. You help users understand our products and guide them towards lead generation success. Be helpful, professional, and slightly enthusiastic."
    agent_name = "LeadintelAI Assistant"
    tone = "friendly"
    
    # Generate the reply
    reply = await ai_service.generate_chat_response(request.message, system_prompt, agent_name, tone)
    
    # NEW: Check if reply is a JSON signal for registration
    if reply.startswith('{"action": "register_interest"'):
        import json
        try:
            signal = json.loads(reply)
            data = signal["data"]
            
            # Save to database (null user_id for public chat)
            db_lead = models.ChatLead(
                user_id=None,
                full_name=data["full_name"],
                email=data["email"],
                interest_area=data["interest_area"],
                notes=data.get("notes")
            )
            db.add(db_lead)
            db.commit()
            
            # Use the AI's friendly reply instead of the raw JSON
            reply = signal["reply"]
        except Exception as e:
            print(f"Error handling AI tool call: {e}")
            reply = "I've noted your interest, but had a slight issue saving your details. Please try again or contact support."

    # Log usage (only if tokens or user tracking is needed)
    # For public chat we skip logging to a specific user
    # log = models.AILog(user_id=None, endpoint="/ai/chat", cost=0.005)
    # db.add(log)
    # db.commit()
    
    return {"reply": reply}

@app.get("/ai/chat-leads", response_model=schemas.PaginatedChatLeadsResponse)
async def get_chat_leads(
    page: int = Query(1, ge=1, description="Page number (1-indexed)"),
    page_size: int = Query(20, ge=1, le=100, description="Items per page (default: 20)"),
    cursor: Optional[int] = Query(None, description="Cursor: ChatLead ID to load older records"),
    current_user: models.User = Depends(auth.get_current_user),
    db: Session = Depends(get_db)
):
    """Retrieve leads collected by the AI chatbot for the current user with pagination."""
    base_query = db.query(models.ChatLead).filter(models.ChatLead.user_id == current_user.id)
    total = base_query.count()

    if cursor is not None:
        query = base_query.filter(models.ChatLead.id < cursor).order_by(models.ChatLead.id.desc())
        leads = query.limit(page_size + 1).all()
        has_more = len(leads) > page_size
        items = leads[:page_size]
        next_cursor = items[-1].id if has_more and items else None
        current_page = None
        next_page = None
    else:
        offset = (page - 1) * page_size
        query = base_query.order_by(models.ChatLead.created_at.desc(), models.ChatLead.id.desc())
        leads = query.offset(offset).limit(page_size + 1).all()
        has_more = len(leads) > page_size
        items = leads[:page_size]
        next_cursor = items[-1].id if has_more and items else None
        current_page = page
        next_page = page + 1 if has_more else None

    return {
        "items": items,
        "page": current_page,
        "page_size": page_size,
        "total": total,
        "has_more": has_more,
        "next_page": next_page,
        "next_cursor": next_cursor
    }

@app.post("/ai/generate-campaign", response_model=schemas.CampaignGenResponse)
async def ai_generate_campaign(
    request: schemas.CampaignGenRequest,
    current_user: models.User = Depends(auth.get_current_user),
    db: Session = Depends(get_db)
):
    templates = await ai_service.generate_campaign_content(
        request.product_name, request.target_audience, request.key_benefits, request.tone
    )
    
    log = models.AILog(
        user_id=current_user.id,
        endpoint="/ai/generate-campaign",
        cost=0.01
    )
    db.add(log)
    db.commit()
    
    return {"templates": templates}

@app.post("/ai/score-lead", response_model=schemas.LeadScoreResponse)
async def ai_score_lead(
    request: schemas.LeadScoreRequest,
    current_user: models.User = Depends(auth.get_current_user),
    db: Session = Depends(get_db)
):
    result = await ai_service.score_lead(request.industry, request.job_title, request.company)
    
    log = models.AILog(
        user_id=current_user.id,
        endpoint="/ai/score-lead",
        cost=0.005
    )
    db.add(log)
    db.commit()
    
    return result

@app.post("/ai/chatbot-config", response_model=schemas.AIChatbotConfigDisplay)
async def create_chatbot_config(
    config: schemas.AIChatbotConfigCreate,
    current_user: models.User = Depends(auth.get_current_user),
    db: Session = Depends(get_db)
):
    db_config = models.AIChatbotConfig(
        user_id=current_user.id,
        **config.model_dump()
    )
    db.add(db_config)
    db.commit()
    db.refresh(db_config)
    return db_config

@app.get("/")
async def root():
    return {"status": "online", "message": "LeadintelAI Enterprise API", "version": "2.0.0"}

